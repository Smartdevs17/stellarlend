{
  "name": "@stellarlend/data-lake",
  "version": "1.0.0",
  "description": "Data lake ETL for raw StellarLend blockchain data (Parquet on object storage)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "etl:daily": "tsx src/etl/run-daily.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.3.0",
    "hyparquet": "^1.26.2",
    "hyparquet-writer": "^0.16.1",
    "winston": "^3.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
