{
  "name": "stellarlend",
  "version": "1.0.0",
  "description": "Stellar Lending Protocol",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest --testPathPattern=test/unit",
    "test:integration": "jest --testPathPattern=test/integration",
    "test:differential": "jest --testPathPattern=test/differential --reporters=default --reporters=jest-junit",
    "test:differential:report": "ts-node scripts/generate-differential-report.ts",
    "lint": "eslint . --ext .ts",
    "prettier": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "stellar",
    "lending",
    "defi",
    "smart-contracts"
  ],
  "author": "SmartDevs17",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^11.0.0",
    "fast-check": "^3.13.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "test/**/*.ts"
    ],
    "coverageDirectory": "coverage",
    "testResultsProcessor": "jest-junit",
    "reporters": [
      "default",
      ["jest-junit", {
        "outputDirectory": "test-results",
        "outputName": "junit.xml"
      }]
    ]
  }
}
