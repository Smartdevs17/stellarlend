{
  "name": "stellarlend",
  "version": "1.0.0",
  "private": true,
  "description": "Stellar Lending Protocol (npm workspace root for api, oracle, packages/*)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "api",
    "oracle",
    "packages/sdk",
    "packages/ui-lending"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:differential": "jest --testPathPattern=\"/test/differential/\" --reporters=default --reporters=jest-junit",
    "test:differential:report": "ts-node scripts/generate-differential-report.ts",
    "prettier": "prettier --write \"test/**/*.ts\"",
    "install:all": "npm install --workspaces",
    "build:all": "npm run build -w stellarlend-api && npm run build -w stellarlend-oracle && npm run build -w @stellarlend/sdk && npm run build -w @stellarlend/ui-lending",
    "lint:all": "npm run lint -w stellarlend-api && npm run lint -w stellarlend-oracle",
    "test:all": "npm test && npm run test -w stellarlend-api && npm run test -w stellarlend-oracle && npm run test -w @stellarlend/ui-lending"
  },
  "keywords": [
    "stellar",
    "lending",
    "defi",
    "smart-contracts"
  ],
  "author": "SmartDevs17",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.5.0",
    "fast-check": "^3.13.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "test/**/*.ts"
    ],
    "coverageDirectory": "coverage",
    "testResultsProcessor": "jest-junit",
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-results",
          "outputName": "junit.xml"
        }
      ]
    ]
  }
}
