{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
    },
    "lint": {
      "outputs": []
    },
    "cargo-check": {
      "inputs": ["Cargo.toml", "Cargo.lock", "contracts/**/*.rs", "contracts/**/Cargo.toml"],
      "outputs": ["target/debug/.fingerprint/**", "target/debug/deps/**"],
      "cache": true
    }
  }
}
