# Stellar Network
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Bot Account
BOT_SECRET_KEY=
BOT_PUBLIC_KEY=

# Liquidation Strategy
MIN_PROFIT_THRESHOLD_XLM=1.0
MAX_GAS_PRICE_STROOPS=100000
LIQUIDATION_TARGET_STRATEGY=highest_profit
# Options: highest_profit, highest_risk, lowest_hf

# Monitoring
POLL_INTERVAL_MS=5000
DRY_RUN=true
MAX_CONCURRENT_LIQUIDATIONS=3

# WebSocket
WS_URL=ws://localhost:3000/api/ws/health-updates

# API
API_BASE_URL=http://localhost:3000/api

# Optional signed liquidation notifications
LIQUIDATION_WEBHOOK_URL=
LIQUIDATION_WEBHOOK_SECRET=
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_MS=500

# Logging
LOG_LEVEL=info
